{
  "name": "hedera-proof-of-spend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent that spends money you can audit without trusting the auditor.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-npm-version.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/e2e.ts",
    "start:store": "node packages/store/src/index.ts",
    "verify": "node packages/verifier/src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hiero-ledger/sdk": "2.87.0"
  }
}
