# Supply-chain policy for every workspace in this repo.
#
# Only resolve package versions that have been public for at least 7 days.
# npm compromises are typically detected and unpublished within hours, so a
# cooldown window blocks a poisoned version before it can enter the lockfile.
#
# Does NOT affect `npm ci` from an existing lockfile — that resolves nothing.
#
# Requires npm >= 11.10.0. SILENTLY IGNORED on older npm, which is why a
# preinstall hook refuses to run below that version. Check with `npm --version`
# — NOT with `npm config get min-release-age`, which just echoes this file back
# and prints 7 even where the setting does nothing.
min-release-age=7

# NOTE: `strict-allow-scripts` and `allow-scripts[]` are NOT npm settings.
# npm 11.10.0 reports them as "Unknown project config" and ignores them, so an
# allow-list written here is decoration, not a control. npm's real lever is
# `ignore-scripts=true`, which is all-or-nothing and would break esbuild's
# platform-binary postinstall. Left off deliberately rather than faked.
# Audit install scripts instead:  npm ls --all --parseable | ... (see docs/design.md)
