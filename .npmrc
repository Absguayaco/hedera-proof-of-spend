# Supply-chain policy for every workspace in this repo.
#
# Only resolve package versions that have been public for at least 7 days.
# npm compromises are typically detected and unpublished within hours, so a
# cooldown window blocks a poisoned version before it can enter the lockfile.
#
# Does NOT affect `npm ci` from an existing lockfile — that resolves nothing.
min-release-age=7

# Install scripts approved for this repo, pinned to exact versions so a future
# (possibly compromised) release is NOT covered and must be re-reviewed.
#
# VERSION-SENSITIVE: npm 11.10.0 reports `allow-scripts` as "Unknown project
# config" and ignores it; npm 11.19.0 implements it and warns about packages
# not yet covered. Node 24 ships 11.19.0, which is the floor this repo sets, so
# it is a real control here — but on an older npm it silently does nothing,
# which is why the preinstall hook refuses to run below 11.10.0.
#
# Verified 2026-09-07 against the install tree. fsevents is os:darwin and
# optional, so it is absent on the Linux CI runner and present on any macOS
# checkout -- the list has to cover it or enforcement passes CI and breaks
# every Mac.
#
# ENFORCED, not advisory. Without strict-allow-scripts, npm treats the list
# below as a note: it warns that a package is "not yet covered by allowScripts"
# and then runs the script anyway. Measured on npm 11.19.0 against a dependency
# with an unlisted postinstall -- warned, installed, script executed. With this
# line, the same install stops with ESTRICTALLOWSCRIPTS and the script does not
# run. A list nothing checks is documentation, not a control.
strict-allow-scripts=true
allow-scripts[]=esbuild@0.28.1
allow-scripts[]=fsevents@2.3.3
allow-scripts[]=protobufjs@7.6.6
allow-scripts[]=protobufjs@8.0.1

# Enforce the "engines" field in package.json instead of merely warning about
# it. Without this, `npm ci` on Node 20 or 22 installs cleanly and the repo
# then fails later with ERR_UNKNOWN_FILE_EXTENSION for a ".ts" file — an error
# that names neither Node nor the requirement. Same reasoning as the npm floor
# above: a requirement that fails silently is worse than one that fails loudly.
engine-strict=true
